{
  "manifest_version": 3,
  "name": "ARSM 网页助手",
  "version": "1.0.0",
  "description": "在 asmr.one 标记已入库作品，并把未入库作品交给 ARSM Suite 下载。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:17641/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ARSM 网页助手"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://asmr.one/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
